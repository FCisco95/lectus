{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Lectus Settings",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 540,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      },
      {
        "label": "pill",
        "title": "",
        "width": 64,
        "height": 64,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "x": 100,
        "y": 100
      }
    ]
  },
  "bundle": {
    "macOS": {
      "frameworks": [
        "target/release/libggml-base.0.dylib",
        "target/release/libggml.0.dylib",
        "target/release/libllama-common.0.dylib",
        "target/release/libllama.0.dylib"
      ]
    },
    "resources": {
      "target/release/build/llama-cpp-sys-2-*/out/backends/*.so": "backends/"
    }
  }
}
