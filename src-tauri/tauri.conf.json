{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lectus",
  "version": "0.4.0",
  "identifier": "ai.organic.lectus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Lectus Settings",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 540,
        "visible": false,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "pill",
        "title": "",
        "width": 72,
        "height": 72,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "x": 100,
        "y": 100
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../models/ggml-tiny.en.bin": "models/ggml-tiny.en.bin",
      "icons/tray-idle.png": "icons/tray-idle.png",
      "icons/tray-recording.png": "icons/tray-recording.png",
      "icons/tray-transcribing.png": "icons/tray-transcribing.png"
    }
  }
}
